# ========================================================
# BUILDNOTES MERN BLOG APPLICATION - ENVIRONMENT VARIABLES
# ========================================================

# Backend Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# (Make sure MongoDB service is running locally on port 27017)
MONGO_URI=mongodb://127.0.0.1:27017/buildnotes_blog

# JWT Authentication Secret Key
JWT_SECRET=buildnotes_super_secure_jwt_secret_key_2026

# Client / Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage (Optional - Fallbacks to Unsplash stock if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
